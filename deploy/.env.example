# Provider actif (deepseek, mistral, anthropic)
LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-v4-flash

# Fallback Anthropic (optionnel)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Fallback Mistral (optionnel)
# MISTRAL_API_KEY=...
# MISTRAL_MODEL=mistral-small-latest

# Analytics (Umami, auto-hébergé)
UMAMI_DB_PASSWORD=change-moi
UMAMI_APP_SECRET=change-moi-aussi
# ID du site à récupérer dans le dashboard Umami (Settings > Websites) après la
# première configuration, sur https://analytics.decrypterlassemblee.fr — laisser
# vide tant qu'il n'existe pas, le script de tracking ne se charge pas dans ce cas.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
